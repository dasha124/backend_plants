["\u0412\u0435\u0440\u0431\u0435\u043d\u0430 \u0441\u0438\u0440\u0435\u043d\u0435\u0432\u0430\u044f", "\u0411\u0430\u0440\u0445\u0430\u0442\u0446\u044b \"\u041b\u0435\u0433\u0438\u043e\u043d \u0427\u0435\u0441\u0442\u0438\"", "\u0413\u0438\u0430\u0446\u0438\u043d\u0442 \u043c\u0430\u0445\u0440\u043e\u0432\u044b\u0439", "\u041a\u043e\u0441\u043c\u0435\u044f \"\u0421\u043e\u043d\u0430\u0442\u0430 \u041a\u0430\u0440\u043c\u0438\u043d\"", "\u041a\u043e\u0441\u043c\u0435\u044f \u0413\u043b\u043e\u0440\u0438\u044f", "\u041a\u043e\u0441\u043c\u0435\u044f \u0430\u0431\u0440\u0438\u043a\u043e\u0441\u043e\u0432\u0430\u044f", "\u0413\u0438\u0430\u0446\u0438\u043d\u0442 \"\u0413\u043e\u043b\u0443\u0431\u0430\u044f \u0417\u0432\u0435\u0437\u0434\u0430\"", "\u0412\u0435\u0440\u0431\u0435\u043d\u0430 \u041a\u043e\u0440\u043e\u043b\u0435\u0432\u0441\u043a\u0438\u0439 \u041a\u0440\u0430\u0441\u043d\u044b\u0439", "\u0411\u0430\u0440\u0445\u0430\u0442\u0446\u044b \"\u0411\u043e\u043b\u044c\u0448\u0430\u044f \u0417\u043e\u043b\u043e\u0442\u0430\u044f \u0423\u0442\u043a\u0430\"", "\u0411\u0430\u0440\u0445\u0430\u0442\u0446\u044b \u0444\u0440\u0430\u043d\u0446\u0443\u0437\u0441\u043a\u0438\u0435", "\u0413\u0438\u0430\u0446\u0438\u043d\u0442 \"\u0411\u0435\u043b\u0430\u044f \u0416\u0435\u043c\u0447\u0443\u0436\u0438\u043d\u0430\"", "\u0412\u0435\u0440\u0431\u0435\u043d\u0430 \u0422\u0435\u043c\u043d\u044b\u0439 \u0413\u043e\u043b\u0443\u0431\u043e\u0439", "\u0412\u0435\u0440\u0431\u0435\u043d\u0430 \u0421\u0443\u043f\u0435\u0440\u0431\u0435\u043d\u0430 \u0411\u0443\u0440\u0433\u0443\u043d\u0434\u0438", "\u0413\u0438\u0430\u0446\u0438\u043d\u0442 \u0433\u043e\u043b\u043b\u0430\u043d\u0434\u0441\u043a\u0438\u0439", "\u041a\u043e\u0441\u043c\u0435\u044f \"\u041a\u043e\u043d\u0444\u0435\u0442\u043d\u0430\u044f \u041f\u043e\u043b\u043e\u0441\u043a\u0430\"", "\u0412\u0435\u0440\u0431\u0435\u043d\u0430 \u043f\u0440\u0435\u0440\u0438\u0439\u043d\u0430\u044f", "\u0411\u0430\u0440\u0445\u0430\u0442\u0446\u044b \"\u0411\u043e\u043b\u044c\u0448\u0430\u044f \u041e\u0440\u0430\u043d\u0436\u0435\u0432\u0430\u044f \u0423\u0442\u043a\u0430\"", "\u0412\u0435\u0440\u0431\u0435\u043d\u0430 \u043f\u0435\u0440\u0441\u0438\u043a\u043e\u0432\u0430\u044f", "\u0413\u0438\u0430\u0446\u0438\u043d\u0442 \"\u0424\u043e\u043d\u0434\u0430\u043d\u0442\"", "\u041a\u043e\u0441\u043c\u0435\u044f \u0448\u043e\u043a\u043e\u043b\u0430\u0434\u043d\u0430\u044f"]