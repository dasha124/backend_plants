import tensorflow as tf
from tensorflow.keras.applications import InceptionV3
from tensorflow.keras.models import Model
from tensorflow.keras.layers import Dense, GlobalAveragePooling2D

# 1. Загружаем предобученную модель InceptionV3 без верхнего слоя
base_model = InceptionV3(weights='imagenet', include_top=False, input_shape=(299, 299, 3))

# 2. Замораживаем все слои
for layer in base_model.layers:
    layer.trainable = False

# 3. Добавляем новые слои
x = base_model.output
x = GlobalAveragePooling2D()(x)  # Пуллинг слоя
x = Dense(1024, activation='relu')(x)  # Полносвязный слой
predictions = Dense(num_classes, activation='softmax')(x)  # Выходной слой (num_classes — количество классов)

# Создаем новую модель
model = Model(inputs=base_model.input, outputs=predictions)

# 4. Замораживаем все слои, кроме последних 5 слоев
for layer in model.layers[-5:]:  # Размораживаем последние 5 слоев
    layer.trainable = True

# 5. Компилируем модель
model.compile(optimizer=tf.keras.optimizers.Adam(learning_rate=0.0001),
              loss='categorical_crossentropy',
              metrics=['accuracy'])
              
